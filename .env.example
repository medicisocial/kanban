# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password your-username

VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD_HASH=

# Optional: automatic client emails via Resend (https://resend.com)
# Set the same secret in Vercel for both EMAIL_API_SECRET and VITE_EMAIL_API_SECRET
RESEND_API_KEY=
EMAIL_FROM=Medici Social <notifications@yourdomain.com>
EMAIL_API_SECRET=
VITE_EMAIL_API_SECRET=
