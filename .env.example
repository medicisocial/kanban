# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password your-username

VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD_HASH=

# Server-side staff auth for /api/workspace (optional; defaults match production login)
STAFF_USERNAME=staff
STAFF_PASSWORD_HASH=

# Cloud sync — add Upstash Redis via Vercel: Project → Storage → Marketplace → Upstash Redis
# Vercel auto-sets these when the integration is connected:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Client portal URL for brands: https://your-app.vercel.app/?portal=1
# Set usernames/passwords per client under Filter → Client logins (syncs to cloud).

# ── Supabase (per-record sync; replaces the single-blob cloud sync) ───────────
# 1. Run supabase/schema.sql in the Supabase SQL editor.
# 2. Set the keys below (Dashboard → Project Settings → API).
# 3. Flip VITE_USE_SUPABASE to "true" to make the app use the database.
#    While "false" (or keys missing), the app keeps using localStorage as before.
VITE_SUPABASE_URL=https://yzykhrdwplvibzypihvc.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE=false
# Workspace/agency id stamped on every row (single agency for now).
VITE_ORG_ID=medici
