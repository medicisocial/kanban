# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password info@medicisocial.com

VITE_STAFF_USERNAME=info@medicisocial.com
VITE_STAFF_PASSWORD_HASH=

# Server-side staff auth for /api/workspace (optional; defaults match production login)
STAFF_USERNAME=info@medicisocial.com
STAFF_PASSWORD_HASH=

# Cloud sync — add Upstash Redis via Vercel: Project → Storage → Marketplace → Upstash Redis
# Vercel auto-sets these when the integration is connected:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Client portal URL for brands: https://your-app.vercel.app/?portal=1
# Set usernames/passwords per client under Clients → Users (syncs to Supabase).
#
# Local dev: `npm run dev` serves /api routes via scripts/vite-local-api.mjs.
# Client portal login: VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (org-scoped reads).
# Multi-org client logins also need SUPABASE_SERVICE_ROLE_KEY on Vercel (no VITE_ prefix).
# Pull production secrets: vercel env pull .env.local
#
# Production (required for mobile + multi-device staff sync):
#   SUPABASE_SERVICE_ROLE_KEY — server reads/writes in /api/staff-sync (never VITE_ prefix)
#   VITE_SUPABASE_STAFF_PASSWORD — optional; lets staff push from browser without retyping password
# Link staff auth user to org: see supabase/migrations/002_organizations.sql

# ── Supabase (per-record sync; replaces the single-blob cloud sync) ───────────
# 1. Run supabase/schema.sql in the Supabase SQL editor.
# 2. Set the keys below (Dashboard → Project Settings → API).
# 3. Flip VITE_USE_SUPABASE to "true" to make the app use the database.
#    While "false" (or keys missing), the app keeps using localStorage as before.
#
# Client / browser (safe to expose in the frontend bundle):
VITE_SUPABASE_URL=https://yzykhrdwplvibzypihvc.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE=false
# Workspace/agency id for the legacy Medici Social org (unchanged for your admin account).
# New SaaS signups get their own org_id automatically — do not change this for production.
VITE_ORG_ID=medici
# Supabase Auth user used for staff writes under RLS (Dashboard → Authentication → Users).
# Must match the password for VITE_SUPABASE_STAFF_EMAIL (default info@medicisocial.com).
VITE_SUPABASE_STAFF_EMAIL=info@medicisocial.com
VITE_SUPABASE_STAFF_PASSWORD=
# Server-only (NEVER prefix with VITE_ — these must not ship to the browser):
# Required in production for /api/* routes (client portal write-back, auth).
# Dashboard → Project Settings → API → Secret keys → create or rotate.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server overrides (defaults to the VITE_* values above when unset):
# SUPABASE_URL=
# ORG_ID=medici

# ── SaaS multi-tenancy (billing deferred) ─────────────────────────────────────
# After running supabase/migrations/002_organizations.sql, link the legacy staff
# Supabase user to the medici org (one-time):
#
#   insert into organization_members (org_id, user_id, role)
#   select 'medici', id, 'owner' from auth.users
#   where email = 'info@medicisocial.com'
#   on conflict do nothing;
#
# Disable email confirmation in Supabase Auth for frictionless signup during beta,
# or users must confirm email before first sign-in.

# ── Platform email (Resend) — staff sends client notifications from the portal ──
# 1. Create a Resend account and verify your sending domain (or use Resend onboarding domain for testing).
# 2. Add RESEND_API_KEY (server-only, never VITE_).
# 3. Set EMAIL_FROM to a verified sender, e.g. "Medici Social <notifications@medicisocial.com>"
# 4. Optional: AGENCY_NAME (shown in email body), EMAIL_REPLY_TO, PRODUCT_NAME
# RESEND_API_KEY=
# EMAIL_FROM=Medici Social <notifications@medicisocial.com>
# EMAIL_REPLY_TO=info@medicisocial.com
# AGENCY_NAME=Medici Social
# VITE_AGENCY_NAME=Medici Social
