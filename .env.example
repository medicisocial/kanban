# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password your-username

VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD_HASH=

# Gmail OAuth (required for Workspace — app passwords are usually disabled)
# Google Cloud project: medici-client-pipeline
# Redirect URI: https://YOUR-VERCEL-DOMAIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
