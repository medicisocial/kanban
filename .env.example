# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password your-username

VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD_HASH=

# Gmail SMTP (automatic client emails from info@medicisocial.com)
# Create app password: https://myaccount.google.com/apppasswords
# Then run: node scripts/setup-gmail-smtp.mjs YOUR_APP_PASSWORD
GMAIL_USER=info@medicisocial.com
GMAIL_APP_PASSWORD=
