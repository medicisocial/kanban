# Copy to .env and set staff login credentials.
# Generate with: node scripts/generate-staff-hash.mjs your-password your-username

VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD_HASH=

# Gmail send (Vercel → Settings → Environment Variables)
# 1. Google Cloud Console → APIs & Services → Gmail API enabled
# 2. OAuth client (Web) → redirect URI:
#    https://clientpipeline.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
