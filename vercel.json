{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/client-portal-set-password.js": {
      "maxDuration": 60
    },
    "api/spotlight-questionnaire-invite.js": {
      "includeFiles": "api/_lib/assets/**"
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/preview.html", "destination": "/preview.html" },
    { "source": "/((?!preview\\.html$|.*\\.pdf$).*)", "destination": "/index.html" }
  ]
}
